          },
          {
            "name": "Customer Total Spending",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Superstore Sales'[Sales]),",
              "    ALLEXCEPT('Superstore Sales','Superstore Sales'[Customer])",
              ")"
            ],
            "lineageTag": "535c3a2b-3c0c-4de0-9a2d-90c2784e0aa1"
          }
        ],
        "partitions": [
          {
            "name": "Superstore Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Origen = Excel.Workbook(File.Contents(\"C:\\Users\\victo\\Desktop\\victor\\Ing_sistemas\\semestre 8\\gestion de proyectos\\p_inteligencia de negocios\\superstore_sales (1).xlsx\"), null, true),",
                "    #\"Superstore Sales_Sheet\" = Origen{[Item=\"Superstore Sales\",Kind=\"Sheet\"]}[Data],",
                "    #\"Encabezados promovidos\" = Table.PromoteHeaders(#\"Superstore Sales_Sheet\", [PromoteAllScalars=true]),",
                "    #\"Tipo cambiado\" = Table.TransformColumnTypes(#\"Encabezados promovidos\",{{\"Order Date\", Int64.Type}, {\"City\", type text}, {\"Country\", type text}, {\"Category\", type text}, {\"Sales\", type number}, {\"Profit\", type number}, {\"Quantity\", Int64.Type}, {\"Customer\", type text}})",
                "in",
                "    #\"Tipo cambiado\""
              ],
              "type": "m"
            }
          }
        ]
