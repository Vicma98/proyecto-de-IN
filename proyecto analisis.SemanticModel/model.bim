          {
            "name": "Customer Segments",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR TotalCustomerSales =",
              "CALCULATE(",
              "    SUM('Superstore Sales'[Sales]),",
              "    ALLEXCEPT('Superstore Sales','Superstore Sales'[Customer])",
              ")",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    TotalCustomerSales >= 60000, \"VIP\",",
              "    TotalCustomerSales >= 30000, \"Frequent\",",
              "    \"Occasional\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "c582a89d-accc-459b-af28-2c5c7b8edb9f",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "1e98f10a-d2c3-4e59-84b4-ae97e9256759",
        "measures": [
          {
            "name": "Total Sales",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Superstore Sales'[Sales])",
            "lineageTag": "12aeb6b1-6087-476a-a7ba-9ecd8a72ecfd"
          },
          {
            "name": "Average Ticket",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "AVERAGE('Superstore Sales'[Sales])",
            "lineageTag": "b1985582-6c4e-49b6-bc8b-799ed70c53e1"
          },
          {
            "name": "Total Profit",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Superstore Sales'[Profit])",
            "lineageTag": "af9b6375-b050-412f-ba87-58e623b7febe"
          },
          {
            "name": "Profit Margin",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Profit],[Total Sales],0)",
            "lineageTag": "35e00294-c4d5-4479-ad10-47ed5fa369f7"
          },
          {
            "name": "Monthly Sales",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Superstore Sales'[Sales])",
